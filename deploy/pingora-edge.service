# Example systemd unit. Adjust paths and the user to your layout.
[Unit]
Description=pingora-edge TLS edge proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pingora-edge
Group=pingora-edge
WorkingDirectory=/etc/pingora-edge
ExecStart=/usr/local/bin/pingora-edge /etc/pingora-edge/proxy.toml
# SIGHUP re-reads the config, the on-demand host list and static certs.
ExecReload=/bin/kill -HUP $MAINPID
Environment=CONTROL_SOCK=/run/pingora-edge/control.sock
RuntimeDirectory=pingora-edge
StateDirectory=pingora-edge
Restart=on-failure
RestartSec=2
TimeoutStopSec=5
LimitNOFILE=1048576
# Bind :80 and :443 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/pingora-edge /etc/pingora-edge

[Install]
WantedBy=multi-user.target
